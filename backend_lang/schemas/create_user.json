{
  "operation": "CREATE_USER",
  "description": "Create a new user with a permission set",
  "endpoint": "/ops/create_user",
  "method": "POST",
  "fields": {
    "first_name": {"type": "string", "required": true, "examples": ["Rahul", "Emily"]},
    "last_name": {"type": "string", "required": true},
    "email": {"type": "string", "required": true, "format": "email"},
    "permission_set": {"type": "string", "required": true, "examples": ["Admin", "Manager"]}
  }
}
